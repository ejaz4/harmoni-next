generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Canonical entities hold Harmoni's own view of the metadata.
// *Source tables link each one to its copies on providers ("ytm:abc").

model Song {
  id         String       @id @default(uuid())
  title      String
  titleKey   String // normalised core title, used to find match candidates
  durationMs Int?
  isrc       String?
  explicit   Boolean      @default(false)
  artworkUrl String?
  albumId    String?
  album      Album?       @relation(fields: [albumId], references: [id])
  artists    SongArtist[]
  sources    SongSource[]
  lyrics     Lyrics?
  likes      Like[]
  playlistItems PlaylistItem[]
  plays      Play[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([isrc])
  @@index([titleKey])
}

model SongSource {
  id         String    @id @default(uuid())
  songId     String
  song       Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  provider   String // plugin prefix: "ytm", "deezer"
  externalId String
  confidence Float // matcher score when linked; 1 for the source that created the song
  matchedBy  String // "origin" | "isrc" | "fuzzy" | "manual"
  rawTitle   String // provider's own text, kept so songs can be re-matched later
  rawArtists String[]
  rawAlbum   String?
  durationMs Int?
  isrc       String?
  failCount  Int       @default(0)
  lastOkAt   DateTime?
  lastFailAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([songId])
}

model Artist {
  id        String         @id @default(uuid())
  name      String
  nameKey   String
  imageUrl  String? // square portrait
  bannerUrl String? // wide header photo
  bio       String?
  fans      Int?
  // Cached catalogue built from ArtistProviders (popular song ids, release
  // ids, similar artist ids); rebuilt in the background after profileRefreshAfter.
  profile             Json?
  profileRefreshAfter DateTime?
  songs     SongArtist[]
  albums    Album[]
  sources   ArtistSource[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([nameKey])
}

model ArtistSource {
  id         String   @id @default(uuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  rawName    String
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@index([artistId])
}

model Album {
  id          String        @id @default(uuid())
  title       String
  titleKey    String
  artworkUrl  String?
  releaseDate DateTime?
  kind        String? // "album" | "ep" | "single" | "compilation"
  trackCount  Int?
  label       String?
  genres      String[]
  // Song ids in tracklist order, fetched from a provider on first view.
  trackIds           Json?
  tracksRefreshAfter DateTime?
  artists    Artist[]
  songs      Song[]
  sources    AlbumSource[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([titleKey])
}

model AlbumSource {
  id         String   @id @default(uuid())
  albumId    String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  provider   String
  externalId String
  rawTitle   String
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@index([albumId])
}

model SongArtist {
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  position Int // credit order
  role     String // "primary" | "featured"

  @@id([songId, artistId])
  @@index([artistId])
}

// Lyrics cached per song. `lines` is the provider-independent format
// (see src/server/lyrics/types.ts); found=false records a miss. Cached rows
// are always served; after refreshAfter they're rechecked in the background.
model Lyrics {
  songId     String    @id
  song       Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  found      Boolean
  provider   String?
  sync       String? // "word" | "line" | "none"
  lines      Json?
  language   String?
  fetchedAt    DateTime  @default(now())
  refreshAfter DateTime?
}

// --- Accounts (Better Auth). Field names match better-auth's schema with the
// username plugin; ids are generated by better-auth. ---

model User {
  id              String    @id
  name            String
  email           String    @unique // placeholder: Harmoni logs in by username
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  role            String    @default("user") // "admin" | "user"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]
  invitesCreated  Invite[]  @relation("InvitesCreated")
  inviteUsed      Invite?   @relation("InviteUsed")
  likes           Like[]
  playlists       Playlist[]
  plays           Play[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hash
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// After the first (admin) account, signing up needs a one-time invite code.
model Invite {
  id          String    @id @default(uuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// --- Per-user library ---

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, songId])
  @@index([userId, createdAt])
}

model Playlist {
  id          String         @id @default(uuid())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  items       PlaylistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  @@index([playlistId, position])
}

// A listen, recorded once a song has played long enough to count.
model Play {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId   String
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([songId])
}
