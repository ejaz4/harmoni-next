DATABASE_URL="postgresql://harmoni:harmoni@127.0.0.1:5433/harmoni?schema=public"

# Optional: enables the Spotify search provider (client credentials flow)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# yt-dlp sidecar (docker compose service "ytdlp")
YTDLP_URL="http://127.0.0.1:3101"

# Where played audio is cached
CACHE_DIR="./data/cache"

# iTunes store country for search results (ISO code, e.g. US, GB, JP)
ITUNES_COUNTRY="US"

# Optional: enables the TIDAL search provider. Free app at developer.tidal.com (no subscription needed)
TIDAL_CLIENT_ID=""
TIDAL_CLIENT_SECRET=""
TIDAL_COUNTRY="US"

# Lyrics providers to try, in order (default: lrclib,ytm)
# LYRICS_ORDER="lrclib,ytm"
